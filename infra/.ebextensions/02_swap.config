# 2 GB of swap on the (2 GB) server, so a memory spike makes the site slow
# for a moment instead of freezing it (it did, during the photo run).
commands:
  01_swapfile:
    command: |
      if [ ! -f /swapfile ]; then
        fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile
      fi
      swapon --show | grep -q /swapfile || swapon /swapfile
      sysctl -w vm.swappiness=10
    ignoreErrors: true
